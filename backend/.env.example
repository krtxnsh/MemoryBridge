# Server & Environment
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/memorybridge?schema=public"

# Authentication Secrets (Generate with: openssl rand -base64 48)
# In production, must be >= 32 characters and never use placeholders
JWT_ACCESS_SECRET="dev_jwt_access_secret_change_in_production_min_32_chars_1"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_change_in_production_min_32_chars_2"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:5173"

# Demo Mode Guard (Allows anonymous demo patient session and reset-demo only when true and not production)
DEMO_MODE="true"

# Storage Configuration (local | firebase | mock)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
STORAGE_SIGNING_SECRET=""

# Storage Limits & Quotas
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=26214400
MAX_VIDEO_BYTES=209715200
UPLOAD_URL_TTL_SEC=600
MEDIA_READ_URL_TTL_SEC=3600
MAX_MEDIA_PER_MEMORY=20
PATIENT_STORAGE_QUOTA_BYTES=5368709120
MAX_PENDING_UPLOADS_PER_USER=10

# Firebase Cloud Storage (Required when STORAGE_PROVIDER=firebase)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# AI Provider Stub (none | rule_based)
AI_PROVIDER="none"

# -------------------------------------------------------------------
# LLM phrasing layer (provider-independent, backend-only credentials)
# -------------------------------------------------------------------
# The LLM is ONLY used to rephrase facts already retrieved from verified
# memories. It never introduces new facts and is never called when no verified
# memory matches (the safe fallback is returned instead).
#
#   none      - disabled; deterministic rule-based replies only (default)
#   mock      - offline deterministic grounded provider (no key, good for CI/dev)
#   openai    - OpenAI-compatible Chat Completions (set LLM_API_KEY, LLM_MODEL)
#   anthropic - Anthropic Messages API (set LLM_API_KEY, LLM_MODEL)
LLM_PROVIDER="none"
# API key is read on the BACKEND ONLY and never sent to the client.
LLM_API_KEY=""
# Model id, e.g. "gpt-4o-mini" (openai) or "claude-3-5-haiku-latest" (anthropic)
LLM_MODEL=""
# Optional override for an OpenAI-compatible / self-hosted gateway base URL.
LLM_BASE_URL=""
# Abort the provider call after this many ms, then fall back to the grounded reply.
LLM_TIMEOUT_MS=8000
LLM_MAX_TOKENS=320

# Verified-memory semantic retrieval
EMBEDDING_PROVIDER="local_semantic"
MEMORY_RETRIEVAL_THRESHOLD=0.24
MEMORY_RETRIEVAL_MIN_COVERAGE=0.34
