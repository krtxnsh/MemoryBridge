# Server & Environment
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/memorybridge?schema=public"

# Authentication Secrets (Generate with: openssl rand -base64 48)
# In production, must be >= 32 characters and never use placeholders
JWT_ACCESS_SECRET="dev_jwt_access_secret_change_in_production_min_32_chars_1"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_change_in_production_min_32_chars_2"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:5173"

# Demo Mode Guard (Allows anonymous demo patient session and reset-demo only when true and not production)
DEMO_MODE="true"

# Storage Configuration (local | firebase | mock)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
STORAGE_SIGNING_SECRET=""

# Storage Limits & Quotas
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=26214400
MAX_VIDEO_BYTES=209715200
UPLOAD_URL_TTL_SEC=600
MEDIA_READ_URL_TTL_SEC=3600
MAX_MEDIA_PER_MEMORY=20
PATIENT_STORAGE_QUOTA_BYTES=5368709120
MAX_PENDING_UPLOADS_PER_USER=10

# Firebase Cloud Storage (Required when STORAGE_PROVIDER=firebase)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# AI Provider Stub (none | rule_based)
AI_PROVIDER="none"
